# Copy this file to `.env` and fill in the values. The `.env` file is gitignored.
#
# NOTE: EXPO_PUBLIC_* variables are inlined into the app bundle at build time
# and are therefore NOT secret in the distributed app. Keep them out of source
# control (rotation, per-environment values), but never rely on them to hide
# truly secret credentials — those belong server-side.

# Strapi GraphQL endpoint
EXPO_PUBLIC_GRAPHQL_URL=https://your-strapi-host/graphql

# Strapi API bearer token. ROTATE the previously committed token before use.
EXPO_PUBLIC_STRAPI_TOKEN=replace-with-a-rotated-strapi-token
