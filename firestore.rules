// S360 Firestore rules, PHASE 1 (transition).
//
// Goal: close everything that can be closed without breaking the deployed V2 app.
// Known phase-1 concessions (all to be closed at cutover, Plan 5):
//   - `users` is publicly readable: the V2 PIN login reads it without a session.
//   - `gamebox` is publicly readable: V2 queries where('userid','==',uid), possibly without a session.
//
// Publicar so depois de apagar as functions antigas (Plano 2, Task 21): os agendadores legados
// escrevem games, players, news, standings, summary, videos, lineups, statistics e tweets pelo SDK
// web NAO autenticado, e estas regras partiam-nos. Ate la a producao mantem as regras atuais.
//
// Accepted phase-1 risk: `rankings` allows unlimited +1 increments by the owner. V2 increments
// points client-side (one +1 per prediction transaction), so this cannot be tightened without
// breaking V2. Closed at cutover (Plan 5), when points move server-side. (+1 inflation risk
// stays documented and accepted for phase 1.)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Doc id ends with '_' + uid (literal compare, no regex on the uid).
    function idEndsWithUid(id) {
      return id.size() > request.auth.uid.size()
          && id[id.size() - request.auth.uid.size() - 1:] == '_' + request.auth.uid;
    }

    // Public-read data, backend-written only.
    match /{col}/{id} {
      allow read: if col in ['games', 'news', 'players', 'standings', 'videos', 'lineups',
                             'summaries', 'stastistics', 'tweets'];
    }

    // Backend-owned results (public names only), read-only for clients.
    match /pointEvents/{id} { allow read: if true; }
    match /settlements/{id} { allow read: if true; }
    match /mvpVotes/{id} { allow read: if true; }
    match /matchPredictions/{id} { allow read: if true; }
    match /leaderboards/{id} { allow read: if true; }
    match /leaderboards/{id}/entries/{entry} { allow read: if true; }

    // Modelo novo (Plano 2): leitura publica, escrita so pelo Admin SDK (que ignora as regras).
    // `ingestHealth`, `ingestState` e as coleções `_shadow_*` (ensaio em sombra) ficam fechadas
    // pelo "negado por omissao" no fim do ficheiro.
    match /matches/{id} { allow read: if true; }
    match /matches/{id}/{sub=**} { allow read: if true; }
    match /competitions/{id} { allow read: if true; }
    match /competitions/{id}/{sub=**} { allow read: if true; }
    match /teams/{id} { allow read: if true; }
    match /teams/{id}/{sub=**} { allow read: if true; }
    match /venues/{id} { allow read: if true; }
    // config/app e lido SEM sessao (portao de atualizacao obrigatoria antes do login).
    // ATENCAO: todos os documentos em config/ sao publicos (leitura sem sessao). Configuracao privada
    // (chaves, listas internas, flags de operacao) tem de viver noutra colecao, nunca aqui.
    match /config/{id} { allow read: if true; }

    // Public profile (name + avatar only, never email), written by the updateProfile callable.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // users: public read (phase 1), owner-only writes. `displayName` and `nameChangedAt` are server-only (updateProfile
    // callable validates it); the V2 app never writes it, so it keeps working.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
                    && !('displayName' in request.resource.data)
                    && !('nameChangedAt' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'nameChangedAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // gamebox: field `userid` (lowercase).
    match /gamebox/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.userid == request.auth.uid
                    && request.resource.data.userid == resource.data.userid;
      allow delete: if signedIn() && resource.data.userid == request.auth.uid;
    }

    // predictions and manofmatch: id is {gameId}_{uid}, create-only. `source` is reserved for
    // server-written (v2027 callable) docs; clients cannot set it.
    match /predictions/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && !('source' in request.resource.data)
                    && idEndsWithUid(id);
    }
    match /manofmatch/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && !('source' in request.resource.data)
                    && idEndsWithUid(id);
    }

    // rankings: id is exactly {uid}_{season} (V2 rankingDocId); V2 increments points by 1
    // (merge-set in a transaction). Id and `season` field are tied together so a user cannot
    // create extra rows; exact-id compare avoids '_' ambiguity in uids.
    match /rankings/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.season is string
                    && request.resource.data.season.matches('^[0-9]{4}-[0-9]{4}$')
                    && id == request.auth.uid + '_' + request.resource.data.season
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.points == 1;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.season == resource.data.season
                    && id == request.auth.uid + '_' + resource.data.season
                    && request.resource.data.points == resource.data.points + 1;
    }

    // Everything else: denied by default.
  }
}
