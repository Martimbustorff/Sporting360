    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@firebase/firestore": "^4.7.5",
    "axios": "^1.7.9",
    "firebase": "^11.0.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.14",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.5"
  },
  "private": true
}
