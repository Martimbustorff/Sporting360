{
  "expo": {
    "name": "S360",
    "slug": "s3602027",
    "scheme": "s360",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.scp360",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-PT",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scp360",
      "adaptiveIcon": {
        "backgroundColor": "#001B13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001B13",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 240
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/analytics",
      "@react-native-firebase/app-check",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.394641993263-84tree10asc01anqldkhog14sbqq1k7b"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ],
      "expo-image",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite à S360 usar o Face ID para desbloquear a app."
        }
      ],
      "expo-screen-orientation",
      [
        "expo-camera",
        {
          "cameraPermission": "A S360 usa a câmara para ler o código da tua GameBox.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "sprintia-development",
    "extra": {
      "eas": {
        "projectId": "f387402f-a79b-45e3-aefa-54c6c4ece63f"
      }
    }
  }
}
